<%- include('header') %>
<div class="card narrow">
  <h2><%= appt.id ? 'Editar consulta' : 'Nova consulta' %></h2>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form method="post" action="/consultas<%= appt.id ? '/' + appt.id : '' %>">
    <% if (user.role === 'admin') { %>
    <label>Paciente *
      <select name="user_id" required>
        <% members.forEach(m => { %><option value="<%= m.id %>" <%= appt.user_id == m.id ? 'selected' : '' %>><%= m.name %></option><% }) %>
      </select>
    </label>
    <% } %>
    <label>Data e hora *<input type="datetime-local" name="date_time" value="<%= appt.date_time || '' %>" required></label>
    <label>Médico
      <select name="doctor_id">
        <option value="">— não informado —</option>
        <% doctors.forEach(d => { %><option value="<%= d.id %>" <%= appt.doctor_id == d.id ? 'selected' : '' %>><%= d.name %><%= d.specialty ? ' (' + d.specialty + ')' : '' %></option><% }) %>
      </select>
      <span class="muted">Não está na lista? <a href="/medicos">Cadastre o médico</a></span>
    </label>
    <label>Especialidade<input name="specialty" value="<%= appt.specialty || '' %>" placeholder="Ex.: Pediatria"></label>
    <label>Local<input name="location" value="<%= appt.location || '' %>" placeholder="Endereço da clínica"></label>
    <label>Motivo<textarea name="reason" rows="2"><%= appt.reason || '' %></textarea></label>
    <label>O que levar<input name="bring" value="<%= appt.bring || '' %>" placeholder="Ex.: carteirinha, exames anteriores"></label>
    <div class="grid">
      <label>Status
        <select name="status"><% statuses.forEach(s => { %><option <%= appt.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select>
      </label>
      <label>Lembrete (dias antes)<input type="number" name="remind_days_before" min="0" max="30" value="<%= appt.remind_days_before %>"></label>
    </div>
    <button>Salvar</button>
  </form>
  <% if (appt.id) { %>
  <form method="post" action="/consultas/<%= appt.id %>/excluir" onsubmit="return confirm('Excluir esta consulta?')">
    <button class="danger">Excluir consulta</button>
  </form>
  <% } %>
</div>
<%- include('footer') %>
