<%- include('header') %>
<div class="card">
  <h2>🔔 Lembretes para enviar</h2>
  <p class="muted">Clique em <strong>Enviar</strong>: o WhatsApp abre com a mensagem pronta. Depois de enviar, marque como enviado.</p>
  <% if (!pending.length) { %><p>✅ Nenhum lembrete pendente. Tudo em dia!</p><% } %>
  <ul class="list">
    <% pending.forEach(r => { %>
    <li class="<%= r.overdue ? 'overdue' : '' %>">
      <div>
        <% if (r.overdue) { %><span class="tag status-cancelada">⚠️ atrasado</span><% } else { %><span class="tag">enviar hoje</span><% } %>
        <strong><%= r.patient %></strong> · <%= [r.doctor, r.specialty].filter(Boolean).join(' – ') || 'Consulta' %>
        <div class="muted"><%= formatDateTime(r.date_time) %> · WhatsApp: <%= r.whatsapp %></div>
      </div>
      <div class="actions">
        <a class="btn whatsapp" href="<%= r.link %>" target="_blank" rel="noopener">📲 Enviar</a>
        <form method="post" action="/lembretes/<%= r.id %>/enviado"><button class="secondary">✅ Marcar enviado</button></form>
      </div>
    </li>
    <% }) %>
  </ul>
</div>
<div class="card">
  <h3>Histórico de enviados</h3>
  <% if (!sent.length) { %><p class="muted">Nenhum lembrete enviado ainda.</p><% } %>
  <ul class="list">
    <% sent.forEach(r => { %>
    <li>
      <div><strong><%= r.patient %></strong> · consulta <%= formatDateTime(r.date_time) %>
        <div class="muted">Enviado em <%= r.reminder_sent_at %></div></div>
      <form method="post" action="/lembretes/<%= r.id %>/desfazer"><button class="small secondary">Desfazer</button></form>
    </li>
    <% }) %>
  </ul>
</div>
<%- include('footer') %>
