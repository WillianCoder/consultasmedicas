<%- include('header') %>
<div class="card narrow">
  <h2>Criar conta</h2>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form method="post" action="/cadastro">
    <label>Nome *<input name="name" value="<%= form.name || '' %>" required></label>
    <label>E-mail *<input type="email" name="email" value="<%= form.email || '' %>" required></label>
    <label>Senha * <span class="muted">(mínimo 6 caracteres)</span><input type="password" name="password" minlength="6" required></label>
    <label>WhatsApp * <span class="muted">(com DDD, para receber lembretes)</span><input name="whatsapp" value="<%= form.whatsapp || '' %>" placeholder="(11) 99999-9999" required></label>
    <%- include('health_fields', { form }) %>
    <button>Criar conta</button>
  </form>
  <p>Já tem conta? <a href="/login">Entrar</a></p>
</div>
<%- include('footer') %>
