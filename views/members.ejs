<%- include('header') %>
<div class="card">
  <h2>Família</h2>
  <p class="muted">Para adicionar alguém, peça para a pessoa criar a conta em <strong>/cadastro</strong>.</p>
  <ul class="list">
    <% members.forEach(m => { %>
    <li>
      <div>
        <strong><%= m.name %></strong> <span class="tag"><%= m.role %></span>
        <div class="muted"><%= m.email %> · WhatsApp: <%= m.whatsapp %><%= m.blood_type ? ' · Tipo ' + m.blood_type : '' %><%= m.allergies ? ' · Alergias: ' + m.allergies : '' %></div>
      </div>
      <% if (m.id !== user.id) { %>
      <form method="post" action="/membros/<%= m.id %>/papel">
        <input type="hidden" name="role" value="<%= m.role === 'admin' ? 'membro' : 'admin' %>">
        <button class="small secondary"><%= m.role === 'admin' ? 'Tornar membro' : 'Tornar admin' %></button>
      </form>
      <% } %>
    </li>
    <% }) %>
  </ul>
</div>
<%- include('footer') %>
