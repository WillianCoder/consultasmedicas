<%- include('header') %>
<div class="card narrow">
  <h2>Meu perfil <span class="tag"><%= user.role %></span></h2>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form method="post" action="/perfil">
    <label>Nome *<input name="name" value="<%= form.name %>" required></label>
    <label>E-mail<input value="<%= user.email %>" disabled></label>
    <label>WhatsApp *<input name="whatsapp" value="<%= form.whatsapp %>" required></label>
    <%- include('health_fields', { form }) %>
    <label>Nova senha <span class="muted">(deixe em branco para manter)</span><input type="password" name="password" minlength="6"></label>
    <button>Salvar</button>
  </form>
</div>
<%- include('footer') %>
