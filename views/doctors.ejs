<%- include('header') %>
<div class="card">
  <h2>Médicos e clínicas</h2>
  <% if (!doctors.length) { %><p class="muted">Nenhum médico cadastrado.</p><% } %>
  <ul class="list">
    <% doctors.forEach(d => { %>
    <li>
      <div>
        <strong><%= d.name %></strong> <% if (d.specialty) { %><span class="tag"><%= d.specialty %></span><% } %>
        <div class="muted"><%= [d.crm && 'CRM ' + d.crm, d.phone, d.address].filter(Boolean).join(' · ') %></div>
      </div>
      <% if (user.role === 'admin') { %>
      <form method="post" action="/medicos/<%= d.id %>/excluir" onsubmit="return confirm('Excluir este médico?')"><button class="small danger">Excluir</button></form>
      <% } %>
    </li>
    <% }) %>
  </ul>
</div>
<div class="card narrow">
  <h3>Cadastrar médico</h3>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form method="post" action="/medicos">
    <label>Nome *<input name="name" required></label>
    <div class="grid">
      <label>Especialidade<input name="specialty"></label>
      <label>CRM<input name="crm"></label>
    </div>
    <label>Telefone<input name="phone"></label>
    <label>Endereço<input name="address"></label>
    <button>Cadastrar</button>
  </form>
</div>
<%- include('footer') %>
