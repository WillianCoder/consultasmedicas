<details class="optional" <%= (form.birth_date || form.blood_type || form.allergies || form.insurance) ? 'open' : '' %>>
  <summary>Dados de saúde <span class="muted">(opcional – pode preencher depois)</span></summary>
  <div class="grid">
    <label>Data de nascimento<input type="date" name="birth_date" value="<%= form.birth_date || '' %>"></label>
    <label>Tipo sanguíneo
      <select name="blood_type">
        <option value="">Não informado</option>
        <% ['A+','A-','B+','B-','AB+','AB-','O+','O-'].forEach(t => { %>
          <option <%= form.blood_type === t ? 'selected' : '' %>><%= t %></option>
        <% }) %>
      </select>
    </label>
    <label>Convênio<input name="insurance" value="<%= form.insurance || '' %>" placeholder="Ex.: Unimed"></label>
    <label>Nº da carteirinha<input name="insurance_number" value="<%= form.insurance_number || '' %>"></label>
  </div>
  <label>Alergias<textarea name="allergies" rows="2" placeholder="Ex.: dipirona, amendoim"><%= form.allergies || '' %></textarea></label>
  <label>Contato de emergência<input name="emergency_contact" value="<%= form.emergency_contact || '' %>" placeholder="Nome e telefone"></label>
</details>
